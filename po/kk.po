"автоматты түрде үздіксіз 22кГц тоны жіберіледі."

#: modules/access/dtv/access.c:201
msgid "Continuous 22kHz tone"
msgstr "Үздіксіз 22кГц тоны"

#: modules/access/dtv/access.c:203
msgid ""
