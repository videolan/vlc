#: modules/spu/marq.c:130 modules/spu/mosaic.c:171 modules/spu/rss.c:172
msgid "Bottom-Right"
msgstr "Төменгі-оң жақ"

#: src/libvlc-module.c:298
msgid "Zoom video"
msgstr "Видео масштабы"

#: src/libvlc-module.c:300
msgid "You can zoom the video by the specified factor."
msgstr "Видео масштабын көрсетілген коэффициент бойынша өзгерте аласыз."

#: src/libvlc-module.c:302
msgid "Grayscale video output"
msgstr "Сұр түсті видео шығысы"

#: src/libvlc-module.c:304
msgid ""
"Output video in grayscale. As the color information aren't decoded, this can "
"save some processing power."
msgstr ""
"Видеоны сұр түспен шығару. Түс ақпараты декодталмайтындықтан, бұл біраз "
"өңдеу қуатын сақтауға мүмкіндік береді."

#: src/libvlc-module.c:307
msgid "Embedded video"
msgstr "Ендірілген видео"

#: src/libvlc-module.c:309
msgid "Embed the video output in the main interface."
msgstr "Видео шығысын негізгі интерфейске ендіру."

#: src/libvlc-module.c:311
msgid "Fullscreen video output"
msgstr "Толық экранды видео шығысы"

#: src/libvlc-module.c:313
msgid "Start video in fullscreen mode"
msgstr "Видеоны толық экран режимінде бастау"

#: src/libvlc-module.c:315 src/video_output/vout_intf.c:253
msgid "Always on top"
msgstr "Әрқашан үстінде"

#: src/libvlc-module.c:317
msgid "Always place the video window on top of other windows."
msgstr "Видео терезесін әрқашан басқа терезелердің үстіне орналастыру."

#: src/libvlc-module.c:319
msgid "Enable wallpaper mode"
msgstr "Тұсқағаз режимін іске қосу"

#: src/libvlc-module.c:321
msgid ""
"The wallpaper mode allows you to display the video as the desktop background."
msgstr ""
"Тұсқағаз режимі видеоны жұмыс үстелінің фоны ретінде көрсетуге рұқсат етеді."

#: src/libvlc-module.c:324
msgid "Show media title on video"
msgstr "Медиа атауын видеода көрсету"

#: src/libvlc-module.c:326
msgid "Display the title of the video on top of the movie."
msgstr "Видео атауын фильмнің үстінде көрсету."

#: src/libvlc-module.c:328
msgid "Show video title for x milliseconds"
msgstr "Видео атауын x миллисекунд бойы көрсету"

#: src/libvlc-module.c:330
msgid "Show the video title for n milliseconds, default is 5000 ms (5 sec.)"
msgstr ""
"Видео атауын n миллисекунд бойы көрсету, бастапқы мәні — 5000 мс (5 сек.)"

#: src/libvlc-module.c:332
msgid "Position of video title"
msgstr "Видео атауының орны"

#: src/libvlc-module.c:334
msgid "Place on video where to display the title (default bottom center)."
msgstr "Видеода атау көрсетілетін орын (үнсіз келісім бойынша төменгі орта)."

#: src/libvlc-module.c:336
msgid "Hide cursor and fullscreen controller after x milliseconds"
msgstr "Курсорды және толық экран контроллерін x миллисекундтан кейін жасыру"

#: src/libvlc-module.c:339
msgid "Hide mouse cursor and fullscreen controller after n milliseconds."
msgstr ""
"Тышқан курсорын және толық экран контроллерін n миллисекундтан кейін жасыру."

#: src/libvlc-module.c:342 src/libvlc-module.c:344
#: src/video_output/interlacing.c:112 modules/gui/macosx/VLCMainMenu.m:443
#: modules/gui/macosx/VLCMainMenu.m:444
#: modules/gui/macosx/VLCSimplePrefsController.m:386
#: modules/gui/qt/dialogs/convert.cpp:123 modules/hw/vdpau/chroma.c:896
#: modules/video_filter/deinterlace/deinterlace.c:300
#: share/lua/http/dialogs/create_stream.html:346
msgid "Deinterlace"
msgstr "Деинтерлейстеу"

#: src/libvlc-module.c:352 src/video_output/interlacing.c:128
#: modules/gui/macosx/VLCMainMenu.m:445 modules/gui/macosx/VLCMainMenu.m:446
#: modules/gui/macosx/VLCSimplePrefsController.m:387
#: modules/video_filter/deinterlace/deinterlace.c:256
msgid "Deinterlace mode"
msgstr "Деинтерлейстеу режимі"

#: src/libvlc-module.c:354
msgid "Deinterlace method to use for video processing."
msgstr "Видеоны өңдеу үшін пайдаланылатын деинтерлейстеу әдісі."

#: src/libvlc-module.c:361 modules/video_filter/deinterlace/deinterlace.h:58
msgid "Discard"
msgstr "Тастау"

#: src/libvlc-module.c:361 modules/video_filter/deinterlace/algo_phosphor.h:47
#: modules/video_filter/deinterlace/deinterlace.h:58
msgid "Blend"
msgstr "Араластыру"

#: src/libvlc-module.c:361 modules/video_filter/deinterlace/deinterlace.h:58
msgid "Mean"
msgstr "Орташа мән"

#: src/libvlc-module.c:361 modules/hw/vdpau/chroma.c:883
#: modules/video_filter/deinterlace/deinterlace.h:58
msgid "Bob"
msgstr "Bob"

#: src/libvlc-module.c:362 modules/video_filter/deinterlace/deinterlace.h:59
msgid "Phosphor"
msgstr "Phosphor"

#: src/libvlc-module.c:363 modules/video_filter/deinterlace/deinterlace.h:59
msgid "Film NTSC (IVTC)"
msgstr "Film NTSC (IVTC)"

#: src/libvlc-module.c:371
msgid "Disable screensaver"
msgstr "Экран сақтағышты сөндіру"

#: src/libvlc-module.c:372
msgid "Disable the screensaver during video playback."
msgstr "Видеоны ойнату кезінде экран сақтағышты сөндіру."

#: src/libvlc-module.c:374 modules/gui/macosx/VLCSimplePrefsController.m:372
#: modules/gui/qt/ui/sprefs_video.h:314
msgid "Window decorations"
msgstr "Терезе безендірулері"

#: src/libvlc-module.c:376
msgid ""
"VLC can avoid creating window caption, frames, etc... around the video, "
"giving a \"minimal\" window."
msgstr ""
"VLC видео айналасында терезе тақырыбын, кадрларды және т.б. жасаудан қашып, "
"«минималды» терезе ұсына алады."

#: src/libvlc-module.c:379
msgid "Video splitter module"
msgstr "Видео бөлгіш модулі"

#: src/libvlc-module.c:381
msgid "This adds video splitters like clone or wall"
msgstr "Бұл клон немесе қабырға сияқты видео бөлгіштерді қосады"

#: src/libvlc-module.c:383
msgid "Video filter module"
msgstr "Видео сүзгісі модулі"

#: src/libvlc-module.c:385
msgid ""
"This adds post-processing filters to enhance the picture quality, for "
"instance deinterlacing, or distort the video."
msgstr ""
"Бұл сурет сапасын арттыру (мысалы, деинтерлейстеу) немесе видеоны бұрмалау "
"үшін өңдеуден кейінгі сүзгілерді қосады."

#: src/libvlc-module.c:389
msgid "Video snapshot directory (or filename)"
msgstr "Видео снапшотының бумасы (немесе файл атауы)"

#: src/libvlc-module.c:391
msgid "Directory where the video snapshots will be stored."
msgstr "Видео снапшоттары сақталатын бума."

#: src/libvlc-module.c:393 src/libvlc-module.c:395
msgid "Video snapshot file prefix"
msgstr "Видео снапшоты файлының префиксі"

#: src/libvlc-module.c:397
msgid "Video snapshot format"
msgstr "Видео снапшотының пішімі"

#: src/libvlc-module.c:399
msgid "Image format which will be used to store the video snapshots"
msgstr "Видео снапшоттарын сақтау үшін қолданылатын сурет пішімі"

#: src/libvlc-module.c:401
msgid "Display video snapshot preview"
msgstr "Видео снапшотының алдын ала қарауын көрсету"

#: src/libvlc-module.c:403
msgid "Display the snapshot preview in the screen's top-left corner."
msgstr ""
"Снапшоттың алдын ала қарауын экранның жоғарғы сол жақ бұрышында көрсету."

#: src/libvlc-module.c:405
msgid "Use sequential numbers instead of timestamps"
msgstr "Уақыт белгілерінің орнына реттік сандарды қолдану"

#: src/libvlc-module.c:407
msgid "Use sequential numbers instead of timestamps for snapshot numbering"
msgstr ""
"Снапшоттарды нөмірлеу үшін уақыт белгілерінің орнына реттік сандарды қолдану"

#: src/libvlc-module.c:409
msgid "Video snapshot width"
msgstr "Видео снапшотының ені"

#: src/libvlc-module.c:411
msgid ""
"You can enforce the width of the video snapshot. By default it will keep the "
"original width (-1). Using 0 will scale the width to keep the aspect ratio."
msgstr ""
"Видео снапшотының енін мәжбүрлеуге болады. Үнсіз келісім бойынша ол бастапқы "
"енін сақтайды (-1). 0 қолданылса, ені арақатынасты сақтау үшін масштабталады."

#: src/libvlc-module.c:415
msgid "Video snapshot height"
msgstr "Видео снапшотының биіктігі"

#: src/libvlc-module.c:417
msgid ""
"You can enforce the height of the video snapshot. By default it will keep "
"the original height (-1). Using 0 will scale the height to keep the aspect "
"ratio."
msgstr ""
"Видео снапшотының биіктігін мәжбүрлеуге болады. Үнсіз келісім бойынша ол "
"бастапқы биіктігін сақтайды (-1). 0 қолданылса, биіктігі арақатынасты сақтау "
"үшін масштабталады."

#: src/libvlc-module.c:421
msgid "Video cropping"
msgstr "Видеоны қиып жіберу"

#: src/libvlc-module.c:423
msgid ""
"This forces the cropping of the source video. Accepted formats are x:y (4:3, "
"16:9, etc.) expressing the global image aspect."
msgstr ""
"Бұл дереккөз видеосын қиып жіберуді мәжбүрлейді. Қабылданатын пішімдер — "
"жалпы бейне сипатын білдіретін x:y (4:3, 16:9, т.б.)."

#: src/libvlc-module.c:427
msgid "Source aspect ratio"
msgstr "Дереккөздің арақатынасы"

#: src/libvlc-module.c:429
msgid ""
"This forces the source aspect ratio. For instance, some DVDs claim to be "
"16:9 while they are actually 4:3. This can also be used as a hint for VLC "
"when a movie does not have aspect ratio information. Accepted formats are "
"x:y (4:3, 16:9, etc.) expressing the global image aspect, or a float value "
"(1.25, 1.3333, etc.) expressing pixel squareness."
msgstr ""
"Бұл дереккөздің арақатынасын мәжбүрлейді. Мысалы, кейбір DVD дискілері 16:9 "
"екенін мәлімдегенмен, іс жүзінде 4:3 болып келеді. Сондай-ақ, бұл фильмде "
"арақатынас туралы ақпарат болмаған кезде VLC үшін тұспал ретінде "
"пайдаланылуы мүмкін. Қабылданатын пішімдер — жалпы бейне сипатын білдіретін "
"x:y (4:3, 16:9, т.б.) немесе пиксель шаршылығын білдіретін жылжымалы нүктелі "
"мән (1.25, 1.3333, т.б.)."

#: src/libvlc-module.c:436
msgid "Video Auto Scaling"
msgstr "Видеоны авто масштабтау"

#: src/libvlc-module.c:438
msgid "Let the video scale to fit a given window or fullscreen."
msgstr ""
"Видеоны берілген терезеге немесе толық экранға сыятындай масштабтауға рұқсат "
"ету."

#: src/libvlc-module.c:440
msgid "Video scaling factor"
msgstr "Видеоны масштабтау коэффициенті"

#: src/libvlc-module.c:442
msgid ""
"Scaling factor used when Auto Scaling is disabled.\n"
"Default value is 1.0 (original video size)."
msgstr ""
"Авто масштабтау сөндірілген кезде қолданылатын масштабтау коэффициенті. \n"
"Үнсіз келісім бойынша мән — 1.0 (бастапқы видео өлшемі)."

#: src/libvlc-module.c:445
msgid "Custom crop ratios list"
msgstr "Пайдаланушылық қиып жіберу арақатынастарының тізімі"

#: src/libvlc-module.c:447
msgid ""
"Comma separated list of crop ratios which will be added in the interface's "
"crop ratios list."
msgstr ""
"Интерфейстің қиып жіберу арақатынастарының тізіміне қосылатын, үтірмен "
"ажыратылған қиып жіберу арақатынастарының тізімі."

#: src/libvlc-module.c:450
msgid "Custom aspect ratios list"
msgstr "Пайдаланушылық арақатынастар тізімі"

#: src/libvlc-module.c:452
msgid ""
"Comma separated list of aspect ratios which will be added in the interface's "
"aspect ratio list."
msgstr ""
"Интерфейстің арақатынастар тізіміне қосылатын, үтірмен ажыратылған "
"арақатынастар тізімі."

#: src/libvlc-module.c:455
msgid "Fix HDTV height"
msgstr "HDTV биіктігін түзету"

#: src/libvlc-module.c:457
msgid ""
"This allows proper handling of HDTV-1080 video format even if broken encoder "
"incorrectly sets height to 1088 lines. You should only disable this option "
"if your video has a non-standard format requiring all 1088 lines."
msgstr ""
"Бұл сынған кодтаушы биіктікті қате түрде 1088 сызыққа орнатқан болса да, "
"HDTV-1080 видео пішімін дұрыс өңдеуге рұқсат береді. Видеоңызда барлық 1088 "
"сызықты талап ететін стандартты емес пішім болса ғана бұл опцияны "
"сөндіруіңіз керек."

#: src/libvlc-module.c:462
msgid "Monitor pixel aspect ratio"
msgstr "Монитор пиксельдерінің арақатынасы"

#: src/libvlc-module.c:464
msgid ""
"This forces the monitor aspect ratio. Most monitors have square pixels "
"(1:1). If you have a 16:9 screen, you might need to change this to 4:3 in "
"order to keep proportions."
msgstr ""
"Бұл монитордың арақатынасын мәжбүрлейді. Мониторлардың көбісінде шаршы "
"пиксельдер (1:1) бар. Егер сізде 16:9 экраны болса, пропорцияларды сақтау "
"үшін мұны 4:3 мәніне өзгертуіңіз қажет болуы мүмкін."

#: src/libvlc-module.c:468 modules/gui/macosx/VLCSimplePrefsController.m:315
msgid "Skip frames"
msgstr "Кадрларды аттап кету"

#: src/libvlc-module.c:470
msgid ""
"Enables framedropping on MPEG2 stream. Framedropping occurs when your "
"computer is not powerful enough"
msgstr ""
"MPEG2 ағынында кадрларды тастауды іске қосады. Кадрларды тастау "
"компьютеріңіздің қуаты жеткіліксіз болған кезде орын алады"

#: src/libvlc-module.c:473
msgid "Drop late frames"
msgstr "Кешіккен кадрларды тастау"

#: src/libvlc-module.c:475
msgid ""
"This drops frames that are late (arrive to the video output after their "
"intended display date)."
msgstr ""
"Бұл кешіккен (видео шығысына жоспарланған көрсету күнінен кейін келетін) "
"кадрларды тастайды."

#: src/libvlc-module.c:478
msgid "Quiet synchro"
msgstr "Тыныш синхрондау"

#: src/libvlc-module.c:480
msgid ""
"This avoids flooding the message log with debug output from the video output "
"synchronization mechanism."
msgstr ""
"Бұл хабарламалар журналын видео шығысын синхрондау механизмінен келетін "
"жөндеу шығысымен толтыруды болдырмайды."

#: src/libvlc-module.c:483
msgid "Key press events"
msgstr "Перне басу оқиғалары"

#: src/libvlc-module.c:485
msgid "This enables VLC hotkeys from the (non-embedded) video window."
msgstr ""
"Бұл (кірістірілмеген) видео терезесінде VLC жедел пернелерін іске қосады."

#: src/libvlc-module.c:487 modules/spu/remoteosd.c:91
msgid "Mouse events"
msgstr "Тышқан оқиғалары"

#: src/libvlc-module.c:489
msgid "This enables handling of mouse clicks on the video."
msgstr "Бұл видеодағы тышқан шертулерін өңдеуді іске қосады."

#: src/libvlc-module.c:497
msgid ""
"These options allow you to modify the behavior of the input subsystem, such "
"as the DVD or VCD device, the network interface settings or the subtitle "
"channel."
msgstr ""
"Бұл опциялар DVD немесе VCD құрылғысы, желі интерфейсінің баптаулары немесе "
"субтитр арнасы сияқты кіріс ішкі жүйесінің әрекетін өзгертуге рұқсат береді."

#: src/libvlc-module.c:501
msgid "File caching (ms)"
msgstr "Файлды кэштеу (мс)"

#: src/libvlc-module.c:503
msgid "Caching value for local files, in milliseconds."
msgstr "Жергілікті файлдар үшін кэштеу мәні, миллисекундпен."

#: src/libvlc-module.c:505
msgid "Live capture caching (ms)"
msgstr "Тікелей түсіруді кэштеу (мс)"

#: src/libvlc-module.c:507
msgid "Caching value for cameras and microphones, in milliseconds."
msgstr "Камералар мен микрофондар үшін кэштеу мәні, миллисекундпен."

#: src/libvlc-module.c:509
msgid "Disc caching (ms)"
msgstr "Дискті кэштеу (мс)"

#: src/libvlc-module.c:511
msgid "Caching value for optical media, in milliseconds."
msgstr "Оптикалық медиа үшін кэштеу мәні, миллисекундпен."

#: src/libvlc-module.c:513
msgid "Network caching (ms)"
msgstr "Желіні кэштеу (мс)"

#: src/libvlc-module.c:515
msgid "Caching value for network resources, in milliseconds."
msgstr "Желілік ресурстар үшін кэштеу мәні, миллисекундпен."

#: src/libvlc-module.c:517
msgid "Clock reference average counter"
msgstr "Сағаттың негізгі орташа есептегіші"

#: src/libvlc-module.c:519
msgid ""
"When using the PVR input (or a very irregular source), you should set this "
"to 10000."
msgstr ""
"PVR кірісін (немесе өте тұрақсыз дереккөзді) пайдаланған кезде, мұны 10000 "
"мәніне орнатуыңыз керек."

#: src/libvlc-module.c:522
msgid "Clock synchronisation"
msgstr "Сағатты синхрондау"

#: src/libvlc-module.c:524
msgid ""
"It is possible to disable the input clock synchronisation for real-time "
"sources. Use this if you experience jerky playback of network streams."
msgstr ""
"Нақты уақыттағы дереккөздер үшін кіріс сағатын синхрондауды сөндіруге "
"болады. Егер желі ағындарын ойнату кезінде кедергілер болса, мұны "
"пайдаланыңыз."

#: src/libvlc-module.c:528
msgid "Clock jitter"
msgstr "Сағат життері"

#: src/libvlc-module.c:530
msgid ""
"This defines the maximum input delay jitter that the synchronization "
"algorithms should try to compensate (in milliseconds)."
msgstr ""
"Бұл синхрондау алгоритмдері өтеуге тырысуы керек кіріс кідірісінің "
"максималды життерін анықтайды (миллисекундпен)."

#: src/libvlc-module.c:533
msgid "Network synchronisation"
msgstr "Желіні синхрондау"

#: src/libvlc-module.c:534
msgid ""
"This allows you to remotely synchronise clocks for server and client. The "
"detailed settings are available in Advanced / Network Sync."
msgstr ""
"Бұл сервер мен клиент үшін сағаттарды қашықтан синхрондауға рұқсат береді. "
"Толық баптаулар Кеңейтілген / Желіні синхрондау бөлімінде қолжетімді."

#: src/libvlc-module.c:540 src/video_output/vout_intf.c:98
#: src/video_output/vout_intf.c:116 modules/access/dshow/dshow.cpp:92
#: modules/access/dshow/dshow.cpp:99 modules/access/dshow/dshow.cpp:119
#: modules/access/dshow/dshow.cpp:2081 modules/audio_output/alsa.c:767
#: modules/audio_output/directsound.c:1048 modules/audio_output/mmdevice.c:1343
